<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NutriLife20Lara" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/coral</item>
        <!-- Texto/ícones sobre a cor primária -->
        <item name="colorOnPrimary">@color/white</item>
        <!-- Cor secundária -->
        <item name="colorSecondary">@color/blue_light</item>
        <!-- Texto/ícones sobre a cor secundária -->
        <item name="colorOnSecondary">@color/blue_darker</item>
        <!-- Fundo principal das telas -->
        <item name="android:colorBackground">@color/dark_background</item>
        <!-- Cor do texto padrão -->
        <item name="android:textColorPrimary">@color/white</item>
        <!-- Cor usada em Cards, Dialogs, BottomSheet -->
        <item name="colorSurface">@color/dark_surface</item>
        <!-- Texto/ícones sobre superfícies -->
        <item name="colorOnSurface">@color/white</item>
        <!-- Cor de erro -->
        <item name="colorError">@color/red_error</item>
        <!-- Texto sobre áreas de erro -->
        <item name="colorOnError">@color/white</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <!-- Ícones claros na status bar -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- Barra de navegação -->
        <item name="android:navigationBarColor">@color/dark_background</item>

        <!-- Tipografia -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.IceCream.Dark.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.IceCream.Dark.Headline2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.IceCream.Dark.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.IceCream.Dark.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.IceCream.Dark.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.IceCream.Dark.Button</item>

    </style>

    <!-- TIPOGRAFIA - MODO ESCURO -->

    <style name="TextAppearance.IceCream.Dark.Headline1"
        parent="@style/TextAppearance.MaterialComponents.Headline1">

        <item name="fontFamily">@font/baloo</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/white</item>

    </style>


    <style name="TextAppearance.IceCream.Dark.Headline2"
        parent="@style/TextAppearance.MaterialComponents.Headline2">

        <item name="fontFamily">@font/baloo</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/white</item>

    </style>


    <style name="TextAppearance.IceCream.Dark.Body1"
        parent="@style/TextAppearance.MaterialComponents.Body1">

        <item name="fontFamily">@font/baloo</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/blue_surface</item>

    </style>


    <style name="TextAppearance.IceCream.Dark.Body2"
        parent="@style/TextAppearance.MaterialComponents.Body2">

        <item name="fontFamily">@font/baloo</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/blue_surface</item>

    </style>


    <style name="TextAppearance.IceCream.Dark.Caption"
        parent="@style/TextAppearance.MaterialComponents.Caption">

        <item name="fontFamily">@font/baloo</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/blue_surface</item>

    </style>


    <style name="TextAppearance.IceCream.Dark.Button"
        parent="@style/TextAppearance.MaterialComponents.Button">

        <item name="fontFamily">@font/baloo</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>

        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>
</resources>